generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String    @id @default(uuid())
  cognitoSub String    @unique @map("cognito_sub")
  email      String  
  name       String
  imagePath  String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([cognitoSub])
  @@index([email])
  @@map("users")
}
