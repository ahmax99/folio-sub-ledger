{
  "name": "api",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm --env disable",
    "check-types": "tsc --noEmit",
    "dev": "bun --watch --preload ./instrument.ts src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1164.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/client-secrets-manager": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@bogeychan/elysia-logger": "^0.1.10",
    "@casl/ability": "^7.1.1",
    "@casl/prisma": "^2.2.0",
    "@elysia/bearer": "^1.4.4",
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/openapi": "^1.4.17",
    "@sentry/bun": "^11.11.0",
    "@shared/config": "workspace:*",
    "@shared/neon": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "elysia": "^1.4.31",
    "elysia-helmet": "^3.1.0",
    "jose": "^6.2.15",
    "neverthrow": "^8.2.0",
    "pino": "^10.4.0",
    "uuid": "14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@shared/typescript-config": "workspace:*",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2",
    "vitest": "5.1.0"
  }
}
